# Copy this file to .env and adjust for your machine. .env is git-ignored.

# Backend server port (default: 8080)
BACKEND_PORT=8080

# Frontend dev server port (default: 5173)
FRONTEND_PORT=5173

# Tool locations. Leave blank to auto-detect from PATH.
# Set these only if java / node / mvn are NOT on your PATH.
# JAVA_HOME: JDK install root (the folder that contains bin\java.exe)
JAVA_HOME=
# NODE_HOME: folder that contains node.exe / npm.cmd
NODE_HOME=
# MAVEN_BIN: full path to mvn.cmd
MAVEN_BIN=
